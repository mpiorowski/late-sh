# Committed compose plumbing and shared dev values for the local stack
# (instance 1). `make start` copies this file verbatim to .env, which is what
# compose reads; a fresh clone needs no env setup at all. Do not edit .env by
# hand; edit this file. For a parallel instance 2 from a second clone, `make
# start-instance2` copies .env.dev2 instead.
# Personal secrets and opt-ins (AI key, YouTube key, R2 upload credentials)
# go in .env.local (gitignored), which compose loads after .env, so it wins
# on duplicate keys.
# App config does NOT live here: late-ssh reads LATE_ENV plus secrets and
# compiles everything else into its profile (late-ssh/src/config.rs).

# --- General (Docker/dev containers) ---
RUST_LOG=info,late_web=debug,late_ssh=debug,late_core=debug
CARGO_TARGET_DIR=/app/target
CARGO_INCREMENTAL=0
CARGO_PROFILE_DEV_DEBUG=1
# Prefix for container names; instance 2 uses late2.
INSTANCE=late

# --- Environment profile (selects the config.rs profile) ---
LATE_ENV=dev

# --- SSH (host port mappings; must match the dev profile in late-ssh/src/config.rs) ---
LATE_SSH_PORT=2222
LATE_API_PORT=4001

# --- Database (credentials only; host/port/pool live in each app's config.rs) ---
LATE_DB_USER=postgres
LATE_DB_PASSWORD=postgres
LATE_DB_NAME=postgres
# Host-side port mapped to postgres 5432.
LATE_PG_HOST_PORT=5433

# --- Audio (host-side port mapped to icecast 8000) ---
LATE_ICECAST_HOST_PORT=8000

# --- Voice (host-side ports for the local LiveKit dev containers) ---
LATE_LIVEKIT_HOST_PORT=7880
LATE_LIVEKIT_RTC_TCP_PORT=7881
LATE_LIVEKIT_RTC_UDP_PORT=7882
# WHIP ingest (`/golive obs`). Only the host side is variable: the container
# side must match the two dev-config.yaml files, and the WHIP URL handed to
# streamers is baked into infra/livekit/dev-config.yaml, so OBS ingest
# targets instance 1 only.
LATE_LIVEKIT_WHIP_HOST_PORT=7888
LATE_LIVEKIT_WHIP_UDP_HOST_PORT=7890
# Local LiveKit credentials. The LiveKit and ingress containers read them
# from their own dev-config.yaml files, so a change here must be mirrored in
# infra/livekit/dev-config.yaml and infra/livekit-ingress/dev-config.yaml.
LATE_LIVEKIT_API_KEY=devkey
LATE_LIVEKIT_API_SECRET=secret

# --- IRC (host port mappings; must match the dev profile) ---
LATE_IRC_PORT=6667
LATE_IRC_TLS_HOST_PORT=6697

# --- Door games (shared secrets and host-pod settings; the late-ssh client
# side, hosts and ports, lives in late-ssh/src/config.rs). These secrets only
# authorize late-ssh against door containers on the local compose network, so
# fixed committed values are fine. Rebels is external (frittura.org): every
# dev on this committed seed shares one identity there; override it in
# .env.local if you want your own. ---
LATE_REBELS_SECRET=late-dev-rebels
LATE_NETHACK_PORT=2323
LATE_NETHACK_SECRET=late-dev-nethack
LATE_DOPEWARS_PORT=2324
LATE_DOPEWARS_SECRET=late-dev-dopewars
# Shared high-score file on the dopewars host (a PVC path in prod).
LATE_DOPEWARS_SCORE_FILE=/tmp/late-dopewars.sco
LATE_BASHQUEST_PORT=2330
LATE_BASHQUEST_SECRET=late-dev-bashquest
# Shared playground HOME on the bashquest host (a PVC path in prod).
LATE_BASHQUEST_DATA_DIR=/tmp/late-bashquest
LATE_CODEKEEP_PORT=2328
LATE_CODEKEEP_SECRET=late-dev-codekeep
# Per-account CodeKeep HOME roots.
LATE_CODEKEEP_DATA_DIR=/var/lib/late-codekeep
LATE_DCSS_PORT=2325
LATE_DCSS_SECRET=late-dev-dcss
LATE_USURPER_PORT=2326
LATE_USURPER_SECRET=late-dev-usurper
LATE_BROGUE_PORT=2327
LATE_BROGUE_SECRET=late-dev-brogue

# --- Web (host port mapping; must match the dev profile in late-web/src/config.rs) ---
LATE_WEB_PORT=3000

# --- Personal opt-ins; real keys go in .env.local, features stay off without ---
# Queue link validation.
LATE_YOUTUBE_API_KEY=
# Gemini for @bot and @graybeard chat + URL extraction.
LATE_AI_API_KEY=
