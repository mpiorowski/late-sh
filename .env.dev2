# Instance 2: a parallel clone of the stack running the dev2 profile. Only
# the instance identity and host port mappings differ from .env.dev; keep
# every other line in sync with it. The port values must match the dev2
# profile in late-ssh/src/config.rs and late-web/src/config.rs.
# See .env.dev for what each setting means and where personal secrets go.

# --- General (Docker/dev containers) ---
RUST_LOG=info,late_web=debug,late_ssh=debug,late_core=debug
CARGO_TARGET_DIR=/app/target
CARGO_INCREMENTAL=0
CARGO_PROFILE_DEV_DEBUG=1
INSTANCE=late2

# --- Environment profile (selects the config.rs profile) ---
LATE_ENV=dev2

# --- SSH ---
LATE_SSH_PORT=2223
LATE_API_PORT=4001

# --- Database ---
LATE_DB_USER=postgres
LATE_DB_PASSWORD=postgres
LATE_DB_NAME=postgres
LATE_PG_HOST_PORT=5434

# --- Audio ---
LATE_ICECAST_HOST_PORT=8001

# --- Voice ---
LATE_LIVEKIT_HOST_PORT=7883
LATE_LIVEKIT_RTC_TCP_PORT=7884
LATE_LIVEKIT_RTC_UDP_PORT=7885
LATE_LIVEKIT_WHIP_HOST_PORT=7891
LATE_LIVEKIT_WHIP_UDP_HOST_PORT=7892
LATE_LIVEKIT_API_KEY=devkey
LATE_LIVEKIT_API_SECRET=secret

# --- IRC ---
LATE_IRC_PORT=6668
LATE_IRC_TLS_HOST_PORT=6698

# --- Door games ---
LATE_NETHACK_PORT=2323
LATE_NETHACK_SECRET=late-dev-nethack
LATE_DOPEWARS_PORT=2324
LATE_DOPEWARS_SECRET=late-dev-dopewars
LATE_DOPEWARS_SCORE_FILE=/tmp/late-dopewars.sco
LATE_CODEKEEP_PORT=2328
LATE_CODEKEEP_SECRET=late-dev-codekeep
LATE_CODEKEEP_DATA_DIR=/var/lib/late-codekeep
LATE_DCSS_PORT=2325
LATE_DCSS_SECRET=late-dev-dcss
LATE_USURPER_PORT=2326
LATE_USURPER_SECRET=late-dev-usurper
LATE_BROGUE_PORT=2327
LATE_BROGUE_SECRET=late-dev-brogue

# --- Web ---
LATE_WEB_PORT=3001

# --- Personal opt-ins; put real keys in .env.local ---
LATE_YOUTUBE_API_KEY=
LATE_AI_API_KEY=
